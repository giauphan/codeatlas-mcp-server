{
  "name": "codeatlas-mcp-server",
  "version": "3.1.1",
  "description": "Local-first MCP server for CodeAtlas — AST analysis, codebase intelligence, semantic memory, and A2A orchestration.",
  "type": "module",
  "bin": {
    "codeatlas-mcp": "dist/index.js",
    "codeatlas-mcp-server": "dist/index.js",
    "codeatlas": "dist/index.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/giauphan/codeatlas-mcp-server.git"
  },
  "homepage": "https://github.com/giauphan/codeatlas-mcp-server#readme",
  "bugs": {
    "url": "https://github.com/giauphan/codeatlas-mcp-server/issues"
  },
  "scripts": {
    "build": "tsc && node scripts/copy-hooks.js",
    "start": "node dist/index.js",
    "dev": "tsx index.ts",
    "lint": "tsc --noEmit",
    "coverage": "c8 --reporter=text --reportDir=coverage npm test",
    "test": "npm run build && node --experimental-test-module-mocks --test \"dist/src/**/*.test.js\"",
    "release": "semantic-release"
  },
  "keywords": [
    "mcp",
    "modelcontextprotocol",
    "codeatlas",
    "code-analysis",
    "ast",
    "ai",
    "codebase-intelligence",
    "enterprise"
  ],
  "author": "Giau Phan <giauphan012@gmail.com>",
  "license": "MIT",
  "engines": {
    "node": ">=20.0.0"
  },
  "devDependencies": {
    "@semantic-release/changelog": "7.0.0",
    "@semantic-release/commit-analyzer": "13.0.1",
    "@semantic-release/git": "11.0.1",
    "@semantic-release/github": "12.0.9",
    "@semantic-release/npm": "13.1.5",
    "@semantic-release/release-notes-generator": "14.1.1",
    "@types/express": "^4.17.21",
    "@types/node": "^20.19.43",
    "c8": "^10.1.3",
    "conventional-changelog-conventionalcommits": "9.3.1",
    "semantic-release": "25.0.9",
    "tsx": "^4.23.1",
    "typescript": "^5.4.0"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.1",
    "@typescript-eslint/typescript-estree": "^8.0.0",
    "chokidar": "^3.6.0",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "glob": "^13.0.6",
    "hono": "^4.12.27",
    "ignore": "^7.0.5",
    "py-ast": "^1.9.0",
    "supergateway": "^3.4.3",
    "zod": "^3.22.4"
  }
}
